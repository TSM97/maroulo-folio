# Copy to .env (or set in your host's dashboard) to enable the contact form.
#
# URL of a form service that accepts a JSON POST and replies with JSON, e.g.
#   Formspree:   https://formspree.io/f/your-form-id
#   Web3Forms:   https://api.web3forms.com/submit  (also needs an access_key field — see their docs)
#
# Leave empty/unset and the form opens a pre-filled email (mailto:) instead.
VITE_FORM_ENDPOINT=
